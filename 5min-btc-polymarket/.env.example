# 5min BTC Polymarket — environment template
# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).
#
#   cp .env.example .env
#
# These credentials are read by scripts/test_btc_5m_session_exit_sl.py (auth_clob_client)
# and forwarded to the external execution engine (pm_live_trade_runner.py).

# --- Polymarket CLOB authentication (required for --execute) ---
# Wallet private key used to sign orders (hex, with or without 0x prefix).
PM_PRIVATE_KEY=

# Funder / proxy wallet address that holds USDC (defaults to PM_ADDRESS if unset).
PM_FUNDER=
PM_ADDRESS=

# Signature type: 1 = email/magic wallet, 2 = browser/proxy wallet (default 2).
PM_SIGNATURE_TYPE=2

# CLOB API credentials (create via Polymarket API key derivation).
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# --- Optional execution tuning (have safe defaults in code) ---
# PM_MAX_SPREAD=1
# PM_MIN_TOP_ASK_NOTIONAL_USD=0
# PM_ORDER_TYPE=FAK
# PM_CLOSE_ORDER_TYPE=FAK

# --- Skill path overrides (see CONTOUR.md) ---
# Path to the order placement/close engine repo (pm-hl-conservative-plus-repo).
# BTC5M_REPO=/abs/path/to/pm-hl-conservative-plus-repo
# Alternate env file location consumed by btc5m_ctl.sh.
# BTC5M_ENV_FILE=/abs/path/to/.env
# Override the canonical runner path.
# BTC5M_RUNNER=/abs/path/to/scripts/test_btc_5m_session_exit_sl.py
