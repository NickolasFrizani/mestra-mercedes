# Template de variáveis de ambiente. Copie para `.env.local` e preencha.
# NUNCA coloque valores reais aqui — este arquivo É versionado.
# Em produção: Vercel → Settings → Environment Variables.

# --- Polymarket CLOB (autenticação L2) ---
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# --- Assinatura de ordens (carteira) ---
POLYMARKET_WALLET_MNEMONIC=
POLYMARKET_SIGNATURE_TYPE=2

# --- RPC Polygon ---
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/SUA_INFURA_KEY

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_ALERT_TO=

# --- OpenAI (opcional) ---
OPENAI_API_KEY=

# ================= COPY TRADING =================
# Ex.: @coldmath = 0x594edb9112f526fa6a80b8f858a6379c8a2c1c11 (alvo padrão se vazio)
COPY_TARGET_WALLETS=
COPY_SIZE_MODE=fixed
COPY_FIXED_USDC=5
COPY_SCALE=0.01
COPY_MIN_USDC=1
COPY_MAX_USDC_PER_TRADE=25
COPY_MIN_SOURCE_USDC=50
COPY_LIVE=false
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
